# ---- copy to .env and fill in ----
# live = call Gnani APIs, mock = offline demo / tests (no credits used)
PROVIDER_MODE=live
ENVIRONMENT=dev

# Gnani speech APIs (Prisma STT + Timbre TTS) — key from https://app.gnani.ai
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
STT_DEFAULT_LANGUAGE=ta-IN
TTS_VOICE_TA=Trisha

# Gnani Evon v3.3 via any OpenAI-compatible server (vLLM / HF Inference Endpoint / tunnel)
EVON_BASE_URL=http://localhost:8000/v1
EVON_API_KEY=EMPTY
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# Security
ADMIN_API_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=30

# Credit guard (programme gives 5,000 credits). Set per-unit costs from your dashboard.
CREDIT_BUDGET=5000
CREDIT_COST_STT_PER_MIN=1.0
CREDIT_COST_TTS_PER_1K_CHARS=1.0

# Phone channel (optional)
PUBLIC_BASE_URL=https://your-public-url.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
